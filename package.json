{
  "name": "@dopplerhq/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for Doppler API with auto-generated tools from OpenAPI specification",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "doppler-mcp": "bin/doppler-mcp"
  },
  "scripts": {
    "fetch-openapi": "curl -s https://docs.doppler.com/openapi/core.json -o doppler-openapi.json",
    "prebuild": "npm run fetch-openapi",
    "build": "tsc && cp doppler-openapi.json dist/",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist/",
    "bin/",
    "doppler-openapi.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "doppler",
    "secrets",
    "api",
    "openapi",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopplerHQ/mcp-server"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "fastmcp": "^4.16.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
